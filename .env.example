# Core application
NODE_ENV=development
PORT=3000
JWT_SECRET=
OWNER_OPEN_ID=
OWNER_NAME=
OWNER_ACCESS_CODE=
OWNER_ACCESS_SESSION_SECRET=
# Stable encryption key for saved GitHub, Railway, Vercel, and Netlify tokens.
# Do not rotate this when changing JWT_SECRET or authentication providers.
PROVIDER_CREDENTIAL_KEY=
# Optional one-time migration key after a previous JWT_SECRET rotation.
PROVIDER_CREDENTIAL_LEGACY_KEY=

# Optional Clerk integration (not required for the private owner workspace)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Supabase persistence (required for workspace data)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Manus built-in AI runtime
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional direct AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
SONAR_API_KEY=

# Authenticated Toríu connections to the existing app suite
TORIU_SERVICE_TOKEN=
EXTRACTORIUM_API_URL=https://extractorium-production.up.railway.app
TEMPLATORIUM_API_URL=https://templatorium-production.up.railway.app

# Optional billing; both secrets are required before payment controls enable
STRIPE_SK=
VITE_STRIPE_PK=
STRIPE_WEBHOOK_SECRET=

# Optional Git and deployment providers
GITHUB_TOKEN=
VERCEL_TOKEN=
NETLIFY_TOKEN=
RAILWAY_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional notifications and infrastructure
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
SENTRY_DSN=
VITE_SENTRY_DSN=
SPRITES_TOKEN=
